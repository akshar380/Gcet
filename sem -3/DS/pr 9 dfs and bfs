#include <stdio.h>
#include <stdlib.h>

int **g, *visited, n;

void dfs(int v)
{
    int i;
    visited[v]=1;
    printf("%d ",v);

    for(i=0;i<n;i++)
        if(g[v][i] && !visited[i])
            dfs(i);
}

void bfs(int v)
{
    int *q=malloc(n*sizeof(int));
    int front=0,rear=0,i;

    visited[v]=1;
    q[rear++]=v;

    while(front<rear)
    {
        v=q[front++];
        printf("%d ",v);

        for(i=0;i<n;i++)
            if(g[v][i] && !visited[i])
            {
                visited[i]=1;
                q[rear++]=i;
            }
    }
    free(q);
}

void reset()
{
    int i;
    for(i=0;i<n;i++)
        visited[i]=0;
}

int main()
{
    int i,j,v,ch;

    printf("Enter number of vertices: ");
    scanf("%d",&n);

    g=malloc(n*sizeof(int*));
    visited=malloc(n*sizeof(int));

    for(i=0;i<n;i++)
        g[i]=malloc(n*sizeof(int));

    printf("Enter adjacency matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<n;j++)
            scanf("%d",&g[i][j]);

    printf("Enter starting vertex: ");
    scanf("%d",&v);

    do
    {
        printf("\n1.DFS 2.BFS 3.Exit");
        printf("\nEnter choice: ");
        scanf("%d",&ch);

        reset();

        switch(ch)
        {
            case 1: dfs(v); break;
            case 2: bfs(v); break;
            case 3: break;
            default: printf("Wrong choice");
        }
    }while(ch!=3);

    for(i=0;i<n;i++)
        free(g[i]);
    free(g);
    free(visited);

    return 0;
}
