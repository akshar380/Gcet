#include <stdio.h>
#include <stdlib.h>

int *a,n;

void display()
{
    int i;
    printf("Array: ");
    for(i=0;i<n;i++)
        printf("%d ",a[i]);
    printf("\n");
}

void insert()
{
    int pos,x,i;
    printf("Enter position and value: ");
    scanf("%d%d",&pos,&x);

    a=realloc(a,(n+1)*sizeof(int));

    for(i=n;i>=pos;i--)
        a[i]=a[i-1];

    a[pos-1]=x;
    n++;
}

void delete()
{
    int pos,i;
    printf("Enter position: ");
    scanf("%d",&pos);

    for(i=pos-1;i<n-1;i++)
        a[i]=a[i+1];

    n--;
    a=realloc(a,n*sizeof(int));
}

void search()
{
    int x,i;
    printf("Enter value: ");
    scanf("%d",&x);

    for(i=0;i<n;i++)
        if(a[i]==x)
        {
            printf("Found at position %d\n",i+1);
            return;
        }

    printf("Not found\n");
}

int main()
{
    int i,ch;

    printf("Enter size: ");
    scanf("%d",&n);

    a=malloc(n*sizeof(int));

    printf("Enter elements: ");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);

    do
    {
        printf("\n1.Insert  2.Delete  3.Display  4.Search  5.Exit");
        printf("\nEnter choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1: insert(); break;
            case 2: delete(); break;
            case 3: display(); break;
            case 4: search(); break;
            case 5: break;
            default: printf("Wrong choice\n");
        }
    }while(ch!=5);

    free(a);
    return 0;
}
