#include <stdio.h>
#include <stdlib.h>

int *q, n, front = -1, rear = -1;

void enqueue()
{
    int x;

    if(rear == n - 1)
        printf("Queue is full\n");
    else
    {
        printf("Enter value: ");
        scanf("%d", &x);

        if(front == -1)
            front = 0;

        q[++rear] = x;
    }
}

void dequeue()
{
    if(front == -1 || front > rear)
        printf("Queue is empty\n");
    else
        printf("Deleted: %d\n", q[front++]);
}

void display()
{
    int i;

    if(front == -1 || front > rear)
        printf("Queue is empty\n");
    else
    {
        for(i = front; i <= rear; i++)
            printf("%d ", q[i]);

        printf("\n");
    }
}

int main()
{
    int ch;

    printf("Enter size: ");
    scanf("%d", &n);

    q = malloc(n * sizeof(int));

    do
    {
        printf("\n1.Enqueue\n2.Dequeue\n3.Display\n4.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);

        if(ch == 1)
            enqueue();
        else if(ch == 2)
            dequeue();
        else if(ch == 3)
            display();

    } while(ch != 4);

    free(q);

    return 0;
}
