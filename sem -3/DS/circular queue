#include <stdio.h>
#include <stdlib.h>
 
#define MAX 5
 
int cqueue[MAX];
int front = -1;
int rear = -1;
 
int isFull() {
    return (front == (rear + 1) % MAX);
}
 
int isEmpty() {
    return front == -1;
}
 
void enqueue(int val) {
    if (isFull()) {
        printf("Circular Queue Overflow\n");
        return;
    }
    if (front == -1)
        front = 0;
    rear = (rear + 1) % MAX;
    cqueue[rear] = val;
}
 
int dequeue() {
    if (isEmpty()) {
        printf("Circular Queue Underflow\n");
        return -1;
    }
    int val = cqueue[front];
    if (front == rear)
        front = rear = -1;
    else
        front = (front + 1) % MAX;
    return val;
}
 
void display() {
    if (isEmpty()) {
        printf("Circular Queue is empty\n");
        return;
    }
    printf("Circular Queue: ");
    int i = front;
    while (1) {
        printf("%d ", cqueue[i]);
        if (i == rear)
            break;
        i = (i + 1) % MAX;
    }
    printf("\n");
}
 
int main() {
    int choice, val;
 
    while (1) {
        printf("\n1. Enqueue\n2. Dequeue\n3. Display\n4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);
 
        switch (choice) {
            case 1:
                printf("Enter value to enqueue: ");
                scanf("%d", &val);
                enqueue(val);
                break;
            case 2:
                val = dequeue();
                if (val != -1)
                    printf("Dequeued value: %d\n", val);
                break;
            case 3:
                display();
                break;
            case 4:
                exit(0);
            default:
                printf("Invalid choice\n");
        }
    }
    return 0;
}
