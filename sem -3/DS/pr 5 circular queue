#include <stdio.h>
#include <stdlib.h>

int *q, n, front = -1, rear = -1;

void enqueue()
{
    int x;

    if((rear + 1) % n == front)
        printf("Queue is full\n");
    else
    {
        printf("Enter value: ");
        scanf("%d", &x);

        if(front == -1)
            front = 0;

        rear = (rear + 1) % n;
        q[rear] = x;
    }
}

void dequeue()
{
    if(front == -1)
        printf("Queue is empty\n");
    else
    {
        printf("Deleted: %d\n", q[front]);

        if(front == rear)
            front = rear = -1;
        else
            front = (front + 1) % n;
    }
}

void display()
{
    int i;

    if(front == -1)
        printf("Queue is empty\n");
    else
    {
        i = front;

        while(1)
        {
            printf("%d ", q[i]);

            if(i == rear)
                break;

            i = (i + 1) % n;
        }

        printf("\n");
    }
}

int main()
{
    int ch;

    printf("Enter size: ");
    scanf("%d", &n);

    q = malloc(n * sizeof(int));

    do
    {
        printf("\n1.Enqueue\n2.Dequeue\n3.Display\n4.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);

        if(ch == 1)
            enqueue();
        else if(ch == 2)
            dequeue();
        else if(ch == 3)
            display();

    } while(ch != 4);

    free(q);

    return 0;
}
